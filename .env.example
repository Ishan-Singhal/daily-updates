# === iMessage (primary delivery, sent from this Mac via Messages.app) ===
# Your own phone number or Apple ID, e.g. +15551234567
IMESSAGE_RECIPIENT=your_phone_number_or_apple_id

# === Gmail (fallback delivery if iMessage fails, e.g. when run off-Mac) ===
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# === OpenWeatherMap (free: https://openweathermap.org/api) ===
OPENWEATHER_API_KEY=your_key_here

# === Puter.com (free AI - get token at puter.com/dashboard) ===
PUTER_TOKEN=your_token_here
